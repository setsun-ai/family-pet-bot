# family-pet-bot configuration. Easiest: run the setup wizard (run.bat --setup / sh run.sh --setup).
# Every option is explained in docs/en/configuration.md (RU: docs/ru/configuration.md).
# This file will hold secrets - never commit or share your .env. It is git-ignored.

# --- required ------------------------------------------------------------------
# telegram | discord - the chat app (the same pet in both)
PLATFORM=telegram
# Telegram bot token: Telegram -> @BotFather -> /newbot
BOT_TOKEN=
# Discord bot token (PLATFORM=discord): see docs/en/discord.md
DISCORD_TOKEN=
# ONE AI provider: claude or openai (only its key is needed)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: a stronger model only for the few automatic posts (matches, praise, birthdays),
# e.g. claude-sonnet-5. Empty = the model above. A few posts a week cost cents.
POST_MODEL=

# --- the pet --------------------------------------------------------------------
# en | ru - bot messages, menu and the AI's instructions
LANGUAGE=en
# Names the pet reacts to in the group (comma-separated). Short inflections match too (Whiskers's, Мурзика).
BOT_NAMES=Whiskers
# The character: a text file. Copy personas/cat.en.md to personas/mypet.local.md and describe YOUR pet
# and family there - *.local.md files are private and never committed.
PERSONA_FILE=personas/cat.en.md
# Emoji the pet may use (max one per message). Empty = any emoji. A cat: 😺😸😹😻😼😽🙀😿😾🐱🐈🐾
PERSONA_EMOJI=
# Optional: your personal numeric Telegram ID. Empty = claim ownership with the one-time link in the console.
OWNER_ID=

# --- schedule -------------------------------------------------------------------
# IANA time zone for all schedules, e.g. Europe/Warsaw, Europe/Kyiv, America/New_York
TIMEZONE=UTC
# No automatic posts between these hours
QUIET_START_HOUR=23
QUIET_END_HOUR=8
# Service notices in the group disappear after N seconds (0 = keep)
NOTICE_SECONDS=8

# --- daily good news --------------------------------------------------------------
NEWS_ENABLED=true
# alternate = 2/1/2/1 posts a day, once, twice, every2days = one post every other day,
# on_request = never posts by itself: keeps a few ready stories for /news and "any news?"
NEWS_MODE=alternate
# on_request only: restock on these weekdays from NEWS_HOUR (0 = Monday), up to NEWS_STOCK_SIZE stories
NEWS_REFRESH_DAYS=0,3
NEWS_STOCK_SIZE=5
NEWS_HOUR=11
NEWS_MINUTE=0
NEWS_EVENING_HOUR=18
NEWS_EVENING_MINUTE=30
# Comma-separated https RSS/Atom feeds. Empty = three built-in English good-news feeds.
NEWS_FEEDS=
MAX_NEWS_AI_CALLS_PER_DAY=6

# --- your team (TheSportsDB, free, any sport) -----------------------------------------
SPORTS_ENABLED=false
# Numeric team id from thesportsdb.com (the wizard finds it by name)
SPORTS_TEAM_ID=
# Command name in Telegram, e.g. match (/match) or your team's name
SPORTS_COMMAND=match
# Match-day announcement window starts at this hour; post final results too?
SPORTS_HOUR=9
SPORTS_RESULTS=true
# full = preview with the table + result with scorers; casual = "the match is starting, watching?" + one line with the score
SPORTS_STYLE=full
# Several teams / ESPN (Champions League, football leagues with scorers and tables):
# a JSON file, see docs/en/configuration.md -> "Several teams". Then SPORTS_TEAM_ID is not needed.
SPORTS_TEAMS_FILE=

# --- the family: weekly praise and birthdays -------------------------------------------
# JSON with the family members (name, about, birthday MM-DD) - keep it private: family.local.json
FAMILY_FILE=
# Once a week praise one member for a small, believable achievement (everyone in turn)
PRAISE_ENABLED=false
# 0 = Monday ... 6 = Sunday, or "any" = a different random day every week.
# Without PRAISE_UNTIL_HOUR the 3-hour window opens at PRAISE_HOUR sharp; with it, at a
# random minute between PRAISE_HOUR and PRAISE_UNTIL_HOUR (e.g. any + 11 + 21 = no fixed schedule at all)
PRAISE_WEEKDAY=5
PRAISE_HOUR=12
PRAISE_UNTIL_HOUR=
BIRTHDAY_HOUR=9
# The pet's own birthday (MM-DD, or YYYY-MM-DD to know its age): it celebrates itself, in a royal mood all day
PET_BIRTHDAY=

# --- reactions: an emoji under family messages, by keyword rules (no AI, nothing stored) ----
# A JSON file with rules, see examples/reactions.example.json and docs/en/configuration.md
REACTIONS_FILE=

# --- the pet's inner life ---------------------------------------------------------------
# A mood of its own (sleepy, playful, grumpy, cuddly...) that changes at random every 1-6 hours
MOOD_ENABLED=true
# Cheer achievements ("I passed!") with a short line and react to bad news, by a local dictionary (no AI)
SENTIMENT_ENABLED=false
# Remember short facts from conversations addressed to the pet (plans, events), for MEMORY_DAYS
MEMORY_ENABLED=false
MEMORY_DAYS=60
# Start a conversation itself on average this many days a week (0-7), only while someone is writing
SPONTANEOUS_PER_WEEK=0
# Join a lively family conversation (by its local vibe: laughing, celebrating, sad, food) at most this often a day
CHIME_IN_PER_DAY=0

# --- limits and memory ----------------------------------------------------------------
# HTTP attempts to the AI per day for the whole bot (not money!). Also set a spending limit at your provider.
MAX_AI_CALLS_PER_DAY=200
USER_REQUESTS_PER_MINUTE=6
# An ordinary chat reply is cut at this many characters ("explain in detail" still gets a long one)
REPLY_MAX_CHARS=300
AI_TIMEOUT_SECONDS=35
HISTORY_DAYS=30
DATABASE_PATH=data/bot.sqlite3
